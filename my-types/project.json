{
  "name": "my-types",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "my-types/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/my-types",
